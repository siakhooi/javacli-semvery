sing.app.semvery.ParametersTest.testPrintUsage=[
Usage: semvery [options]
  Options:
    --operation, -o
      Options: [isValid, isStable, isGreater, isLower, isEqual, isEquivalent]
    --ref, -r
      Reference Value for isGreater, isLower, isEqual, isEquivalent
    --any
      Return success(status 0) if any of the values meet the operation 
      criteria, instead of all values have to meet.
      Default: false
    --output, -O
      Print results as table or json (default: table)
      Default: table
      Possible Values: [table, json]
    --silent, -s
      No output; use exit code only
      Default: false
    --version, -v
      Display version
    --help, -h
      Display help
.
.
]